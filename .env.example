# client-meeting-tasks configuration.
# Copy the values you need into ~/.env (preferred) — the tool reads ~/.env and ./.env,
# and real environment variables override both. Never commit a filled-in copy.

# --- Google Calendar (OAuth, calendar.readonly) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtain via: ./client_meeting_tasks.py auth
GOOGLE_OAUTH_REFRESH_TOKEN=
#CMT_GOOGLE_CALENDAR_ID=primary

# --- Airtable ---
AIRTABLE_API_KEY=
CMT_AIRTABLE_BASE_ID=
#CMT_AIRTABLE_CONTACTS_TABLE=Contacts
#CMT_AIRTABLE_EMAIL_FIELD=Email
#CMT_AIRTABLE_ALT_EMAIL_FIELD=Email (other addresses)
#CMT_AIRTABLE_NAME_FIELD=Name
#CMT_AIRTABLE_STATUS_FIELD=Status Client
#CMT_ACTIVE_STATUSES=Active-coaching,Active-advising

# --- Things / behavior ---
# Must match the project title EXACTLY, including any emoji (e.g. "🌱 Client Ops").
#CMT_THINGS_PROJECT=Client Ops
#CMT_TIMEZONE=America/Los_Angeles
#CMT_DEDUP_WINDOW_DAYS=3
